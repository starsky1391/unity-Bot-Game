  - speaker: "\u5411\u5BFC\u5FAE\u5149"
    text: "\u524D\u65B9\u662F\u6D1E\u7A74\u8BD5\u70BC\u3002\u4F60\u60F3\u4E86\u89E3\u4EC0\u4E48\uFF1F"
