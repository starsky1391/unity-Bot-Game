  - speaker: "\u5411\u5BFC\u5FAE\u5149"
    text: "\u9760\u8FD1\u68C0\u67E5\u70B9\u540E\u4E3B\u52A8\u4E92\u52A8\uFF0C\u53EF\u6062\u590D\u751F\u547D\u5E76\u8BB0\u5F55\u91CD\u751F\u4F4D\u7F6E\u3002\u9000\u51FA\u540E\u9009\u62E9\u7EE7\u7EED\u6E38\u620F\uFF0C\u4E5F\u4F1A\u4ECE\u6700\u8FD1\u8BB0\u5F55\u7684\u68C0\u67E5\u70B9\u51FA\u53D1\u3002"
    choices: []
  - speaker: "\u5411\u5BFC\u5FAE\u5149"
    text: "\u9762\u5BF9\u9752\u8272\u5706\u73AF\uFF0C\u6309 K \u8FDE\u63A5\u524D\u65B9\u6700\u8FD1\u4E14\u65E0\u906E\u6321\u7684\u94A9\u70B9\u3002\u518D\u6309
      K \u677E\u5F00\uFF0C\u6309\u7A7A\u683C\u8DF3\u79BB\u3002\u94A9\u722A\u4E0D\u4F1A\u6062\u590D\u7A7A\u4E2D\u8DF3\u8DC3\u6216\u51B2\u523A\u6B21\u6570\u3002"
